<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>encos_force_sensor</name>
  <version>0.1.0</version>
  <description>
    HKVL-56 六维力/力矩传感器 CAN-FD 驱动节点。
    通过 SocketCAN 或 ZLG USBCANFD-200U 接收 CAN-FD 帧，解析 6×float32 六维力数据，
    转换为 geometry_msgs/WrenchStamped 发布。支持配置任意数量的传感器。
    兼容 ROS2 Humble(x86_64) 与 Jazzy(aarch64/Jetson Thor)。
  </description>
  <maintainer email="dev@example.com">encos</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
