      <origin xyz="0 0 -0.03"/>
      <mass value="0.03"/>
      <inertia ixx="0.00000981" ixy="0" ixz="0" iyy="0.00000916" iyz="0" izz="0.00000097"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.03"/>
      <geometry><box size="0.008 0.018 0.06"/></geometry>
      <material name="gripper_finger_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.03"/>
      <geometry><box size="0.008 0.018 0.06"/></geometry>
    </collision>
  </link>
  <joint name="gripper_r_mimic_joint" type="prismatic">
    <origin xyz="-0.004 0 -0.025"/>
    <parent link="gripper_r_base"/>
    <child link="gripper_r_finger_2"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.035" effort="20" velocity="0.1"/>
    <mimic joint="gripper_r_joint" multiplier="1" offset="0"/>
  </joint>
</robot>
