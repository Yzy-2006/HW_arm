      <material name="gripper_palm_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0125"/>
      <geometry><box size="0.09 0.04 0.025"/></geometry>
    </collision>
  </link>
  <joint name="gripper_r_mount" type="fixed">
    <parent link="arm_r_link_8"/>
    <child link="gripper_r_base"/>
  </joint>
  <link name="gripper_r_finger_1">
    <inertial>
      <origin xyz="0 0 -0.03"/>
      <mass value="0.03"/>
      <inertia ixx="0.00000981" ixy="0" ixz="0" iyy="0.00000916" iyz="0" izz="0.00000097"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.03"/>
      <geometry><box size="0.008 0.018 0.06"/></geometry>
      <material name="gripper_finger_silver"/>
    </visual>
    <collision>
